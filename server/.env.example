# Copy this file to .env (same folder) and fill in your real values.
# .env is git-ignored; this example file is committed so others know what to set.
PORT=3000

# Local MongoDB (mongod running on this PC):
MONGODB_URI=mongodb://127.0.0.1:27017/taskmanager

# MongoDB Atlas (cloud) — use this one when deploying:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/taskmanager?retryWrites=true&w=majority

# Secret used to sign login tokens (JWT). Use a long random value and keep it private.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string

# Optional: how long a login lasts (default 7d)
# JWT_EXPIRES_IN=7d
